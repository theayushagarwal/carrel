{
  "name": "carrel",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm --workspace client run dev",
    "build": "npm run build --workspace shared && npm run build --workspace client && npm run build --workspace server",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "dev:all": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  }
}
