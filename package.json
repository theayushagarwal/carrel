{
  "name": "carrel",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm --workspace client run dev",
    "prebuild": "npm run build --workspace shared",
    "build": "npm run build --workspace shared && npm run build --workspace client && npm run build --workspace server",
    "pretest": "npm run build --workspace shared",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "loadtest": "tsx server/scripts/loadtest.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "dev:all": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  }
}
